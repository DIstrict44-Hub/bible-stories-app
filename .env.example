# Copy to .env and fill in. Leave STRIPE_SECRET_KEY empty for demo mode.
STRIPE_SECRET_KEY=sk_test_...
# Optional: a one-time Price id for Remove Ads. If empty, REMOVE_ADS_AMOUNT_CENTS is used.
STRIPE_PRICE_REMOVE_ADS=price_...
REMOVE_ADS_AMOUNT_CENTS=499
# From Stripe Dashboard > Webhooks (endpoint: https://YOUR_DOMAIN/api/stripe/webhook) or `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: force the public base URL used for Checkout success/cancel redirects
PUBLIC_BASE_URL=
PORT=8787
AD_EVERY=4
CURRENCY=usd
